# ==============================================================================
# LegalEase AI — Environment Configuration Template
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Required for AI summarization, clause extraction, risks, and Q&A)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/legal_assistant

# JWT signing secret (Required for secure authentication and token signing)
# Generate a cryptographically secure 32-byte hex secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_32_byte_random_hex_secret_here
